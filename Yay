from flask import Flask, request, jsonify

app = Flask(__name__)
commute_data = {}

@app.route('/update', methods=['POST'])
def update():
    global commute_data
    commute_data = request.json
    print("Data received:", commute_data)
    return jsonify({"status": "success"})

@app.route('/data', methods=['GET'])
def get_data():
    return jsonify(commute_data)

app.run(host='0.0.0.0', port=5000)
