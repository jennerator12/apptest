# ---------- Helpers ----------

def load_data():
    with open(JSON_PATH) as f:
        return json.load(f)

def encouragement(score):
    if score >= 80:
        return "You’re in a great headspace today 🚗✨"
    elif score >= 50:
        return "You’re doing okay — stay mindful 💛"
    else:
        return "Be gentle with yourself today 🌱"

def animate_bar(bar, target):
    current = bar.winfo_width()
    if current < target:
        bar.config(width=min(current + 5, target))
        bar.after(10, animate_bar, bar, target)
    elif current > target:
        bar.config(width=max(current - 5, target))
        bar.after(10, animate_bar, bar, target)

