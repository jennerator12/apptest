import undetected_chromedriver as uc
from selenium.webdriver.common.by import By
import time

options = uc.ChromeOptions()
options.add_argument("--headless")  # run in background
options.add_argument("--no-sandbox")
options.add_argument("--disable-dev-shm-usage")

driver = uc.Chrome(options=options)

driver.get("https://commutewell.vercel.app/")

time.sleep(5)  # wait for page to render

wellness_elem = driver.find_element(By.CSS_SELECTOR, "div.text-5xl.font-bold.transition-transform")
print("Wellness Score:", wellness_elem.text)

driver.quit()
