import tkinter as tk
import json
from datetime import datetime

JSON_FILE = "/home/pi/commute_data.json"
REFRESH_INTERVAL = 30000  # 30 seconds

def fetch_data():
    with open(JSON_FILE) as f:
        return json.load(f)

def update_dashboard():
    data = fetch_data()
    now = datetime.now()

    date_label.config(text=now.strftime("%A, %B %d"))

    wellness = int(data["wellness_score"])
    wellness_label.config(text=f"{wellness}/100")

    if wellness >= 80:
        msg = "You're in a great headspace 🚗✨"
        bar_color = "#4CAF50"
    elif wellness >= 50:
        msg = "Doing okay — stay mindful 🌤️"
        bar_color = "#FFC107"
    else:
        msg = "Slow down. Breathe. You've got this 💙"
        bar_color = "#F44336"

    message_label.config(text=msg)

    progress_bar.config(width=wellness * 3, bg=bar_color)

    focus_label.config(
        text=f"Today's Focus:\n{data['today_focus']}"
    )

    weekly_label.config(
        text=(
            f"Streak: {data['streak']} days\n"
            f"Tasks: {data['tasks_completed']}/{data['tasks_total']}\n"
            f"Time in car: {data['time_in_car']} min"
        )
    )

    trends_label.config(
        text=(
            f"Energy: {data['energy']}   "
            f"Stress: {data['stress']}   "
            f"Comfort: {data['comfort']}"
        )
    )

    root.after(REFRESH_INTERVAL, update_dashboard)

def animate_bar(bar, target_width, step=5):
    current = bar.winfo_width()
    if current < target_width:
        bar.config(width=min(current + step, target_width))
        bar.after(10, animate_bar, bar, target_width)
    elif current > target_width:
        bar.config(width=max(current - step, target_width))
        bar.after(10, animate_bar, bar, target_width)

# --- UI SETUP ---
root = tk.Tk()
root.title("Commute Well")
root.geometry("480x320")
root.configure(bg="black")

title = tk.Label(
    root, text="Commute Well",
    font=("Helvetica", 22, "bold"),
    fg="white", bg="black"
)
title.pack(pady=5)

date_label = tk.Label(
    root, font=("Helvetica", 14),
    fg="white", bg="black"
)
date_label.pack()

score_frame = tk.Frame(root, bg="black")
score_frame.pack(pady=5)

wellness_label = tk.Label(
    score_frame,
    font=("Helvetica", 36, "bold"),
    fg="white", bg="black"
)
wellness_label.pack()

message_label = tk.Label(
    root, font=("Helvetica", 12),
    fg="white", bg="black"
)
message_label.pack()

bar_bg = tk.Frame(root, bg="#333333", width=300, height=16)
bar_bg.pack(pady=6)
bar_bg.pack_propagate(False)

progress_bar = tk.Frame(bar_bg, height=16, width=0, bg="green")
progress_bar.pack(side="left")

focus_label = tk.Label(
    root, font=("Helvetica", 12),
    fg="white", bg="black",
    justify="center", wraplength=440
)
focus_label.pack(pady=6)

weekly_label = tk.Label(
    root, font=("Helvetica", 11),
    fg="white", bg="black",
    justify="left"
)
weekly_label.pack()

trends_label = tk.Label(
    root, font=("Helvetica", 11),
    fg="white", bg="black"
)
trends_label.pack(pady=4)

update_dashboard()
root.mainloop()
